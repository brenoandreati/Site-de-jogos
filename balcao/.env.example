# Copie para .env e ajuste.
NODE_ENV=development

# Banco PostgreSQL (docker compose up -d sobe um em localhost:5432)
DATABASE_URL=postgres://balcao:balcao@localhost:5432/balcao

# Endereço público do painel/cardápio (usado em links de e-mail e de acompanhamento de pedido)
APP_URL=http://localhost:3000

# API
API_PORT=4000
API_HOST=0.0.0.0
# Segredo para assinar dados internos. Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Onde as imagens enviadas ficam guardadas (driver local)
UPLOAD_DIR=./storage/uploads
LOG_LEVEL=info
# O painel web repassa /api a partir deste endereço; confiar nele permite limitar tentativas por IP real.
TRUST_PROXY=127.0.0.1,::1

# E-mail transacional (recuperação de senha e convites).
# Sem chave: em desenvolvimento o link aparece no log da API; em produção o envio falha com erro claro.
RESEND_API_KEY=
EMAIL_FROM="Balcão <nao-responda@seudominio.com.br>"

# Painel web (Next.js)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── Fase 2: integrações ───
# Chave que cifra os tokens das integrações no banco (32 bytes em base64). Obrigatória em produção.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=
# Endereço público pelo qual Meta e Mercado Pago alcançam os webhooks (padrão: APP_URL).
# Em desenvolvimento, use um túnel HTTPS (ex.: cloudflared) e informe a URL aqui.
PUBLIC_WEBHOOK_URL=

# WhatsApp Business Platform (Cloud API oficial da Meta): dados do app Meta da plataforma.
# App Secret (Configurações do app › Básico) e o token que você define ao cadastrar o webhook
# https://SEU_DOMINIO/api/webhooks/whatsapp no app (campo messages).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Assistente de IA (Anthropic). Sem chave, o assistente fica indisponível e as conversas vão para a equipe.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
