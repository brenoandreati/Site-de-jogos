# Copie para .env e ajuste.
NODE_ENV=development

# Banco PostgreSQL (docker compose up -d sobe um em localhost:5432)
DATABASE_URL=postgres://balcao:balcao@localhost:5432/balcao

# Endereço público do painel/cardápio (usado em links de e-mail e de acompanhamento de pedido)
APP_URL=http://localhost:3000

# API
API_PORT=4000
API_HOST=0.0.0.0
# Segredo para assinar dados internos. Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Onde as imagens enviadas ficam guardadas (driver local)
UPLOAD_DIR=./storage/uploads
LOG_LEVEL=info

# E-mail transacional (recuperação de senha e convites).
# Sem chave: em desenvolvimento o link aparece no log da API; em produção o envio falha com erro claro.
RESEND_API_KEY=
EMAIL_FROM="Balcão <nao-responda@seudominio.com.br>"

# Painel web (Next.js)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
